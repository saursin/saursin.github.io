{% assign _content_len = project.content | strip | size %}
{% if project.redirect %}
  {% assign _project_link = project.redirect %}
{% elsif project.github and _content_len == 0 %}
  {% assign _project_link = project.github %}
{% else %}
  {% assign _project_link = project.url | relative_url %}
{% endif %}
<div class="col">
  <div class="card h-100 hoverable" onclick="window.location='{{ _project_link }}';" style="cursor: pointer;">
    {% if project.img %}
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes = "250px"
        alt="project thumbnail"
        class="card-img-top"
      %}
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">{{ project.title }}</h2>
      <p class="card-text">{{ project.description }}</p>
      <div class="row ml-1 mr-1 p-0">
        {% if project.github %}
          <div class="github-icon">
            <div class="icon" data-toggle="tooltip" title="Code Repository">
              <a href="{{ project.github }}" onclick="event.stopPropagation();"><i class="fa-brands fa-github gh-icon"></i></a>
            </div>
            {% if project.github_stars %}
              <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </div>
        {% endif %}
        {% include project_related_posts_button.liquid project=project %}
      </div>
    </div>
  </div>
</div>
